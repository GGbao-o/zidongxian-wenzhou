<UserControl
    x:Class="AutomatedLine.Ui.Views.MainPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AutomatedLine.Ui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    mc:Ignorable="d">
    <Grid Margin="24,12,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  概览卡片区  -->
        <UniformGrid
            Grid.Row="0"
            Margin="0,0,0,12"
            Columns="4"
            Rows="1">
            <Border Margin="0,0,12,0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="线路状态" />
                    <TextBlock
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="{Binding LineStateBrush}"
                        Text="{Binding LineStateText}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource CaptionText}"
                        Text="{Binding GenerateIntervalMs, StringFormat=生成周期 {0} ms}" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,12,0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="工件任务" />
                    <TextBlock Style="{StaticResource CardMetric}" Text="{Binding TaskCount}" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="内存任务总数" />
                </StackPanel>
            </Border>

            <Border Margin="0,0,12,0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="设备" />
                    <TextBlock
                        Foreground="{StaticResource BrandGreenBrush}"
                        Style="{StaticResource CardMetric}"
                        Text="{Binding DeviceCount}" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="已装载设备数" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="天车" />
                    <TextBlock
                        Foreground="{StaticResource BrandBlueBrush}"
                        Style="{StaticResource CardMetric}"
                        Text="{Binding CraneCount}" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="已装载天车数" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!--  任务列表卡片  -->
        <Border
            Grid.Row="1"
            Padding="0"
            Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,16,20,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="工件任务列表" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,12,0"
                            Appearance="Primary"
                            Command="{Binding ToggleLineCommand}"
                            Content="{Binding LineButtonText}" />
                        <ui:Button
                            Margin="0,0,12,0"
                            Command="{Binding ToggleErpListeningCommand}"
                            Content="{Binding ErpButtonText}" />
                        <ui:Button Command="{Binding AddTaskCommand}" Content="添加任务" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        Style="{StaticResource CaptionText}"
                        Text="{Binding ErpStatusText}"
                        TextWrapping="Wrap" />
                </Grid>

                <!--  DataGrid 自带横竖滚动条，任务多时横向/纵向均可滚动  -->
                <DataGrid
                    Grid.Row="1"
                    Margin="8,0,8,8"
                    AlternatingRowBackground="#F8FAFC"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    CanUserAddRows="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    HorizontalGridLinesBrush="{StaticResource CardBorderBrush}"
                    IsReadOnly="True"
                    ItemsSource="{Binding Tasks}"
                    RowBackground="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding PlateNo}" Header="版号" />
                        <DataGridTextColumn Binding="{Binding SerialNo}" Header="序号" />
                        <DataGridTextColumn Binding="{Binding Diameter}" Header="直径" />
                        <DataGridTextColumn Binding="{Binding Length}" Header="长度" />
                        <DataGridTextColumn Binding="{Binding PlugThickness}" Header="堵厚" />
                        <DataGridTextColumn Binding="{Binding PlugHoleText}" Header="堵孔" />
                        <DataGridTextColumn Binding="{Binding PrintContent}" Header="打印内容" />
                        <DataGridTextColumn Binding="{Binding LatheMachiningModeText}" Header="斜床工艺" />
                        <DataGridTextColumn Binding="{Binding ProcessText}" Header="当前工序" />
                        <DataGridTextColumn Binding="{Binding QueueOrderText}" Header="入线顺序" />
                        <DataGridTextColumn Binding="{Binding LocationText}" Header="当前位置" />
                        <DataGridTextColumn Binding="{Binding NextProcessText}" Header="下一道工序" />
                        <DataGridTextColumn Binding="{Binding NextPositionText}" Header="下一道工序位置" />
                        <DataGridTextColumn Binding="{Binding StateText}" Header="状态" />
                        <DataGridTemplateColumn Header="操作">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button
                                            Margin="0,0,6,0"
                                            Padding="8,2"
                                            Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="编辑"
                                            IsEnabled="{Binding CanEdit}" />
                                        <ui:Button
                                            Margin="0,0,6,0"
                                            Padding="8,2"
                                            Command="{Binding DataContext.StartTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="启动"
                                            IsEnabled="{Binding CanStart}" />
                                        <ui:Button
                                            Margin="0,0,6,0"
                                            Padding="8,2"
                                            Command="{Binding DataContext.PauseTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="暂停"
                                            IsEnabled="{Binding CanPause}" />
                                        <ui:Button
                                            Padding="8,2"
                                            Command="{Binding DataContext.ClearTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="删除"
                                            IsEnabled="{Binding CanClear}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
