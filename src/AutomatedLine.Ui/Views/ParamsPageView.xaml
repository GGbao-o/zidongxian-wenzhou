<UserControl
    x:Class="AutomatedLine.Ui.Views.ParamsPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AutomatedLine.Ui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ParamsViewModel}"
    mc:Ignorable="d">
    <Grid Margin="24,12,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}"
                Text="参数设置" />
            <TextBlock Style="{StaticResource CaptionText}" Text="点击分类卡片弹出该类别参数进行编辑，确定后写回 appsettings.json。" />
        </StackPanel>

        <!-- 参数类别可能越来越多，分类卡片支持横竖滚动 -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Width="300"
                            Margin="0,0,12,12"
                            Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="{Binding Title}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Style="{StaticResource CaptionText}"
                                    Text="{Binding Description}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    Foreground="{StaticResource BrandBlueBrush}"
                                    Text="{Binding ItemCount, StringFormat=共 {0} 项}" />
                                <ui:Button
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding DataContext.OpenCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Content="编辑" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
