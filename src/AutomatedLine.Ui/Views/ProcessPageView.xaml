<UserControl
    x:Class="AutomatedLine.Ui.Views.ProcessPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:AutomatedLine.Ui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ProcessViewModel}"
    mc:Ignorable="d">
    <Border Margin="24,12,24,24" Style="{StaticResource CardBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="新工件工艺设置" />
                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Text="勾选后参与工艺，取消则跳过。保存后仅影响之后首次启动的工件；已启动工件保持原工艺。上料、下料固定保留。" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Text="{Binding RouteText}" />
            </StackPanel>

            <DataGrid
                Grid.Row="1"
                AutoGenerateColumns="False"
                Background="Transparent"
                CanUserAddRows="False"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                HorizontalGridLinesBrush="{StaticResource CardBorderBrush}"
                IsReadOnly="True"
                ItemsSource="{Binding Nodes}"
                RowBackground="Transparent"
                AlternatingRowBackground="#F8FAFC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="顺序" Binding="{Binding Order}" />
                    <DataGridTextColumn Header="工序" Binding="{Binding ProcessText}" />
                    <DataGridTemplateColumn Header="启用">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Margin="8,4" VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanChange}"
                                          Command="{Binding DataContext.ToggleProcessCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="设备类型" Binding="{Binding DeviceTypeText}" />
                    <DataGridTextColumn Header="工序状态" Binding="{Binding StateText}" />
                    <DataGridTextColumn Header="设备数量" Binding="{Binding DeviceCount}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
