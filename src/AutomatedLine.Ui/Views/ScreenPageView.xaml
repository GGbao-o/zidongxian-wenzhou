<UserControl
    x:Class="AutomatedLine.Ui.Views.ScreenPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:AutomatedLine.Ui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ScreenViewModel}"
    mc:Ignorable="d">
    <Grid Margin="24,12,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Foreground="{StaticResource TextPrimaryBrush}"
                Text="大屏展示（只读）" />
            <TextBlock Style="{StaticResource CaptionText}" Text="展示全部设备与天车的实时信号；卡片横向排列，支持横竖滚动。" />
        </StackPanel>

        <!--
            关键：ScrollViewer 同时开启横向与纵向滚动。
            WrapPanel 在无限宽度下会把所有卡片排成一行，因此设备/天车再多也能横向滚动查看，不会被截断。
        -->
        <ScrollViewer
            Grid.Row="1"
            CanContentScroll="False"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BrandGreenBrush}"
                    Text="设备" />

                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="300"
                                Margin="0,0,12,12"
                                Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding TypeText}" />
                                    <TextBlock Margin="0,8,0,0" Text="{Binding SignalSummary}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionText}" Text="{Binding WorkpieceText, StringFormat=当前工件：{0}}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource StatusRunningBrush}"
                                        Text="{Binding StateText}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Margin="0,8,0,8"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BrandBlueBrush}"
                    Text="天车" />

                <ItemsControl ItemsSource="{Binding Cranes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="300"
                                Margin="0,0,12,12"
                                Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Text="{Binding X, StringFormat=X：{0:0.0}}" />
                                    <TextBlock Text="{Binding SignalSummary}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionText}" Text="{Binding TaskText, StringFormat=当前任务：{0}}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource StatusRunningBrush}"
                                        Text="{Binding StateText}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
