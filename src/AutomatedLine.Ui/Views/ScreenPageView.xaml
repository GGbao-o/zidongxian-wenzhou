<UserControl
    x:Class="AutomatedLine.Ui.Views.ScreenPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:AutomatedLine.Ui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ScreenViewModel}"
    mc:Ignorable="d">
    <Grid Margin="24,12,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Foreground="{StaticResource TextPrimaryBrush}"
                Text="大屏展示（只读）" />
            <TextBlock Style="{StaticResource CaptionText}" Text="展示全部设备与天车的实时信号与内存数据；鼠标悬浮卡片查看详情；支持横竖滚动。" />
        </StackPanel>

        <!-- 顶部应用服务卡片：展示调度过程的实时产物（P3 逐步填充） -->
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,12"
            Orientation="Horizontal">
            <Border
                Width="220"
                Margin="0,0,12,0"
                Style="{StaticResource CardBorder}"
                ToolTip="{Binding CandidateTasksText}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="候选任务（TransportTaskGenerator）" />
                    <TextBlock Style="{StaticResource CardMetric}" Text="{Binding CandidateTaskCount}" />
                </StackPanel>
            </Border>
            <Border
                Width="220"
                Style="{StaticResource CardBorder}"
                ToolTip="{Binding DispatchedTasksText}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="已派发任务（集中调度）" />
                    <TextBlock Style="{StaticResource CardMetric}" Text="{Binding DispatchedTaskCount}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!--
            关键：ScrollViewer 同时开启横向与纵向滚动。
            WrapPanel 在无限宽度下会把所有卡片排成一行，因此设备/天车再多也能横向滚动查看，不会被截断。
        -->
        <ScrollViewer
            Grid.Row="2"
            CanContentScroll="False"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BrandGreenBrush}"
                    Text="设备" />

                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 悬浮显示加工状态/工件/信号；边框色：绿=已连接、黄=已预约、红=断开 -->
                            <Border
                                Width="300"
                                Margin="0,0,12,12"
                                ToolTip="{Binding TooltipText}">
                                <Border.Style>
                                    <Style BasedOn="{StaticResource CardBorder}" TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource StatusIdleBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CardStatus}" Value="Reserved">
                                                <Setter Property="BorderBrush" Value="{StaticResource StatusWaitingBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CardStatus}" Value="Faulted">
                                                <Setter Property="BorderBrush" Value="{StaticResource StatusFaultBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding TypeText}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource StatusRunningBrush}"
                                        Text="{Binding MachiningText}" />
                                    <!-- 工件信息与点位信号较多，移到悬浮框显示 -->
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Margin="0,8,0,8"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BrandBlueBrush}"
                    Text="天车" />

                <ItemsControl ItemsSource="{Binding Cranes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 悬浮显示任务/工件/路权；边框色：绿=空闲正常、黄=有任务、红=读失败/报警 -->
                            <Border
                                Width="300"
                                Margin="0,0,12,12"
                                ToolTip="{Binding TooltipText}">
                                <Border.Style>
                                    <Style BasedOn="{StaticResource CardBorder}" TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource StatusIdleBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CardStatus}" Value="Reserved">
                                                <Setter Property="BorderBrush" Value="{StaticResource StatusWaitingBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CardStatus}" Value="Faulted">
                                                <Setter Property="BorderBrush" Value="{StaticResource StatusFaultBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontFamily="Consolas"
                                        Text="{Binding X, StringFormat=X：{0:0.###}}" />
                                    <TextBlock FontFamily="Consolas" Text="{Binding Y, StringFormat=Y：{0:0.###}}" />
                                    <TextBlock FontFamily="Consolas" Text="{Binding Z, StringFormat=Z：{0:0.###}}" />
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionText}" Text="{Binding TaskText, StringFormat=当前任务：{0}}" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="{Binding RightOfWayText, StringFormat=路权：{0}}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource StatusRunningBrush}"
                                        Text="{Binding StateText}" />
                                    <!-- 工件信息较多，移到悬浮框显示 -->
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
