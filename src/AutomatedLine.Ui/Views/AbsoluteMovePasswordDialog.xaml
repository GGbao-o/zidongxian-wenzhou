<ui:FluentWindow
    x:Class="AutomatedLine.Ui.Views.AbsoluteMovePasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="绝对移动确认"
    Width="460"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="绝对移动确认" />
        <StackPanel Grid.Row="1" Margin="24,16,24,24">
            <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
            <TextBlock Margin="0,16,0,6" Text="操作密码" />
            <!--  使用PasswordBox掩码输入，不将密码绑定到普通文本或保存在ViewModel。  -->
            <PasswordBox
                x:Name="PasswordInput"
                Padding="8"
                FontSize="16" />
            <TextBlock
                x:Name="ErrorText"
                MinHeight="24"
                Margin="0,6,0,8"
                Foreground="#B91C1C"
                TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,12,0"
                    Click="OnConfirm"
                    Content="确认并执行"
                    IsDefault="True" />
                <ui:Button Click="OnCancel" Content="取消" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
