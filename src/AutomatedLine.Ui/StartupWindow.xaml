<Window x:Class="AutomatedLine.Ui.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自动线正在启动" Width="480" Height="215"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F7FA">
    <StackPanel Margin="28,22">
        <TextBlock Text="自动线控制系统" FontSize="23" FontWeight="SemiBold" />
        <TextBlock x:Name="StageText" Text="正在准备启动……" Margin="0,16,0,10" FontSize="14" />
        <ProgressBar Height="5" IsIndeterminate="True" />
        <TextBlock x:Name="ElapsedText" Margin="0,12,0,0" Foreground="#626B78" />
    </StackPanel>
</Window>
