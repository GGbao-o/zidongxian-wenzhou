<ui:FluentWindow
    x:Class="AutomatedLine.Ui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AutomatedLine.Ui.ViewModels"
    Title="车间自动化调度系统"
    Width="1280"
    Height="800"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fluent 自绘标题栏；配合 ExtendsContentIntoTitleBar 使用 -->
        <ui:TitleBar Grid.Row="0" Title="车间自动化调度系统" />

        <!-- P0 骨架内容：仅验证 DI 链路与主题样式，后续页面在此基础上替换 -->
        <StackPanel
            Grid.Row="1"
            Margin="32,24,32,32"
            VerticalAlignment="Top">
            <TextBlock
                FontSize="14"
                Opacity="0.65"
                Text="当前线路状态" />
            <TextBlock
                FontSize="34"
                FontWeight="SemiBold"
                Text="{Binding LineStateText}" />

            <TextBlock
                Margin="0,20,0,0"
                FontSize="14"
                Opacity="0.65"
                Text="{Binding GenerateIntervalMs, StringFormat=候选任务生成周期：{0} ms}" />

            <!-- 命令骨架：P0 仅切换状态文本，后续接入 LineControlService -->
            <StackPanel
                Margin="0,28,0,0"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,12,0"
                    Command="{Binding StartLineCommand}"
                    Content="启动线路" />
                <ui:Button
                    Command="{Binding PauseLineCommand}"
                    Content="暂停线路" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
