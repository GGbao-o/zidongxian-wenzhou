<ui:FluentWindow
    x:Class="AutomatedLine.Ui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AutomatedLine.Ui.ViewModels"
    Title="车间自动化调度系统"
    Width="1400"
    Height="860"
    d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fluent 自绘标题栏 -->
        <ui:TitleBar Grid.Row="0" Title="车间自动化调度系统" />

        <!-- 顶部导航栏：点击切换页面 -->
        <Border
            Grid.Row="1"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="0,0,0,1">
            <ListBox
                Margin="16,8"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource NavItemStyle}"
                ItemsSource="{Binding NavItems}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectedItem="{Binding SelectedNav, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontSize="14" Text="{Binding Title}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 内容区：由 DataTemplate 按当前页面 ViewModel 渲染对应 View -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" />
    </Grid>
</ui:FluentWindow>
